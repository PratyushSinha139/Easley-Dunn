# =============================================================================
# deploy/.env.example — template for the SERVER backend .env
#
# Copy to /home/seezle/cerberus/.env (next to docker-compose.yml) and fill in.
# NEVER commit the real .env.
#
# This one file is used twice:
#   1. docker-compose reads it to fill in the ${...} values in docker-compose.yml
#   2. it is passed into cerberus_api as environment variables (env_file)
#
# [REQUIRED] the app or compose will not start, or a core flow will not work
# [OPTIONAL] has a working default; the value shown IS the default
#
# Set by docker-compose.yml, NOT here: DATABASE_URL and PORT (5000). A value
# for either in this file is overridden by the compose file.
# =============================================================================


# ── Compose ──────────────────────────────────────────────────────────────────

# [REQUIRED] release to run, e.g. v0.1.0. No default: every docker-compose
# command stops without it.
IMAGE_TAG=

# [REQUIRED] password for cerberus_db. Also placed inside DATABASE_URL, so use
# letters and digits only (base64 characters such as / break the URL).
# Generate:  openssl rand -hex 32
POSTGRES_PASSWORD=

# [OPTIONAL] database name and user
# POSTGRES_DB=cerberus
# POSTGRES_USER=cerberus_app


# ── Secrets ──────────────────────────────────────────────────────────────────

# [REQUIRED] min 32 chars. Server throws at startup if missing or too short.
# Generate:  openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET=

# [REQUIRED] min 32 chars. Server throws at startup if missing or too short.
# Mixed into every password before hashing.
# Generate:  openssl rand -base64 32
# Set it BEFORE the first admin is created and back it up.
#
# WARNING: NEVER change it once accounts exist. Every stored password stops
# working, admin included.
PASSWORD_PEPPER=


# ── Database ─────────────────────────────────────────────────────────────────

# [REQUIRED] schema the app and migrations use. Production = cerberus.
DB_SCHEMA=cerberus

# [REQUIRED] cerberus_db has no TLS.
DB_SSL=false

# [OPTIONAL] max pooled connections
# DB_CONNECTION_LIMIT=10


# ── Server ───────────────────────────────────────────────────────────────────

# [REQUIRED] turns on secure cookies (needs HTTPS, which Caddy provides).
NODE_ENV=production

# [OPTIONAL] shown in the API docs and logs. Not used for invite links.
API_URL=https://cerberus.easleydunnproductions.com/api

# [OPTIONAL] error | warn | info | http | debug
# LOG_LEVEL=info


# ── CORS ─────────────────────────────────────────────────────────────────────

# [REQUIRED] allowed browser origins, comma-separated.
# THE FIRST ENTRY IS ALSO THE BASE URL FOR INVITE AND RESET LINKS IN EMAILS.
CORS_ORIGINS=https://cerberus.easleydunnproductions.com


# ── Session ──────────────────────────────────────────────────────────────────

# [OPTIONAL] API and frontend are on the same site, so lax.
SESSION_SAMESITE=lax

# [OPTIONAL]
# SESSION_COOKIE_NAME=sid
# SESSION_IDLE_MINUTES=30
# SESSION_ABSOLUTE_HOURS=8


# ── Rate limiting (per IP) ───────────────────────────────────────────────────

# [OPTIONAL] general API traffic
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=1000

# [OPTIONAL] sign-in attempts. Successful sign-ins do not count.
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# LOGIN_RATE_LIMIT_MAX=10


# ── Mail ─────────────────────────────────────────────────────────────────────

# [REQUIRED] invites are how every account gets its first password.
MAIL_SMTP_HOSTNAME=
MAIL_SMTP_PORT=
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM=


# =============================================================================
# INTEGRATIONS — the 5 services live in the beta.
# Key files go in secrets/<folder>/ next to docker-compose.yml, never in git.
# A missing value does not stop the server. It fails when someone clicks grant.
# =============================================================================

# ── Google Play Console ──  key: secrets/googleplay_json/<file>.json
GOOGLE_PLAY_DEVELOPERID=

# ── Apple Store Connect ──  key: secrets/apple_key/<file>.p8
APPLE_KEY_ID=
APPLE_ISSUER_ID=
# [OPTIONAL] the .p8 key as ONE line with \n for newlines, instead of the file.
# APPLE_PRIVATE_KEY=

# ── Google Cloud ──  key: secrets/googlecloud_json/<file>.json
# No variables; the key file is all it reads.

# ── Google Drive ──  key: secrets/googledrive_json/<file>.json
# Folder the service account shares with onboarded users (ID from its URL).
GOOGLE_DRIVE_FOLDER_ID=

# ── Discord ──
DISCORD_BOT_TOKEN=
DISCORD_INVITE_CHANNEL_ID=
DISCORD_GUILD_ID=

# Not live in the beta (no settings here): Unity, BigQuery, Google Analytics,
# Assembla, Firebase, Kanboard.
